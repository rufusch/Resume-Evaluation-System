# Career Lens SMTP (set these in the backend process environment or Codespaces secrets)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=careers@example.com
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
# Use SMTP_SECURITY=ssl and SMTP_PORT=465 if required by your provider.
